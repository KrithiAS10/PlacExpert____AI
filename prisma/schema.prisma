// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  username           String?         @unique
  phone              String?         @unique
  password           String?
  image              String?
  role               String          @default("USER") // USER or ADMIN
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Progress tracking
  currentDay         Int             @default(1)
  readinessScore     Float           @default(0.0)
  streak             Int             @default(0)

  // Student profiling answers
  academicYear       String?
  domainInterest     String?
  targetCompany      String?
  dsaCount           String?
  projects           String?
  coreCsStrength     String?
  codingPlatform     String?
  aptitude           String?
  communication      String?
  mockInterviewExp   String?
  codingConfidence   String?
  dailyStudyTime     String?
  preferredLang      String?
  placementTimeline  String?
  readinessLevel     String?
  leetcodeUsername   String?
  

  roadmaps           Roadmap[]
  surveyResult       SurveyResult?
  analytics          Analytics[]
  activities         Activity[]
  solvedProblems     SolvedProblem[]
  resumes            Resume[]
  interviews         Interview[]
}

model Resume {
  id                 String          @id @default(uuid())
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName           String
  fileUrl            String?
  rawText            String
  parsedData         String          // JSON string: name, skills, education, projects, experience, internships, certifications, achievements
  analysis           String?         // JSON string: strengths, technicalAreas, projects, experienceLevel, potentialTopics, testableSkills, weakAreas
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  interviews         Interview[]

  @@index([userId])
}

model Interview {
  id                 String              @id @default(uuid())
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId           String?
  resume             Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  role               String?
  type               String              @default("Technical") // Technical, HR, Behavioral, Mixed
  difficulty         String              @default("Medium")    // Easy, Medium, Hard
  mode               String              @default("Text")      // Text, Voice
  totalQuestions     Int                 @default(5)
  currentQuestionIndex Int               @default(0)
  status             String              @default("CREATED")   // CREATED, IN_PROGRESS, COMPLETED, CANCELLED
  topicsCovered      String?             // JSON string array of topics
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  questions          InterviewQuestion[]
  answers            InterviewAnswer[]
  report             InterviewReport?

  @@index([userId])
  @@index([resumeId])
}

model InterviewQuestion {
  id                 String              @id @default(uuid())
  interviewId        String
  interview          Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orderIndex         Int
  questionText       String
  category           String              @default("Technical") // Technical, Project, HR, Behavioral, Resume-Based
  topic              String?
  difficulty         String              @default("Medium")
  intent             String?
  isFollowUp         Boolean             @default(false)
  reason             String?
  createdAt          DateTime            @default(now())

  answers            InterviewAnswer[]

  @@index([interviewId])
}

model InterviewAnswer {
  id                   String            @id @default(uuid())
  interviewId          String
  interview            Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId           String
  question             InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText           String
  score                Float             @default(0)
  technicalCorrectness Float             @default(0)
  relevance            Float             @default(0)
  clarity              Float             @default(0)
  completeness         Float             @default(0)
  confidence           Float             @default(0)
  feedback             String?
  strengths            String?           // JSON string array
  weaknesses           String?           // JSON string array
  knowledgeGaps        String?           // JSON string array
  durationSeconds      Int               @default(0)
  createdAt            DateTime          @default(now())

  @@index([interviewId])
  @@index([questionId])
}

model InterviewReport {
  id                     String          @id @default(uuid())
  interviewId            String          @unique
  interview              Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore           Float           @default(0)
  technicalScore         Float           @default(0)
  communicationScore     Float           @default(0)
  problemSolvingScore    Float           @default(0)
  resumeKnowledgeScore   Float           @default(0)
  confidenceScore        Float           @default(0)
  summary                String?
  strengths              String?         // JSON string array
  weaknesses             String?         // JSON string array
  knowledgeGaps          String?         // JSON string array
  resumePerformance      String?         // JSON string array
  improvementSuggestions String?         // JSON string array
  preparationTopics      String?         // JSON string array
  createdAt              DateTime        @default(now())
}

model SurveyResult {
  id            String   @id @default(uuid())
  userId        String   @unique // Ensures one survey result per user
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedRole String
  allScores     String   // Store as a JSON string
  createdAt     DateTime @default(now())
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String   @default("My Prep Roadmap")
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String?
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
  tasks       Task[]
}

model Phase {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {

  id           String   @id @default(uuid())
  title        String
  description  String?
  day          Int      @default(1)
  dayNumber    Int?
  category     String?
  status       String   @default("PENDING")
  type         String   @default("TOPIC")
  resourceName String   @default("Explore Resource")
  resourceLink String   @default("https://roadmap.sh")
  
  roadmapId    String?
  roadmap      Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  phaseId      String?
  phase        Phase?   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  solvedProblems SolvedProblem[]
}

model RoadmapTemplate {
  id           String @id @default(uuid())
  roleName     String
  dayNumber    Int
  title        String
  category     String @default("General")
  resourceName String @default("Explore Resource")
  resourceLink String @default("https://roadmap.sh")

  @@index([roleName])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  type        String
  category    String
  url         String
  duration    String?
  thumbnail   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}


model Analytics {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  metric    String
  value     Float
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  status    String?
  timestamp DateTime @default(now())
}

model SolvedProblem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  solvedAt  DateTime @default(now())
  notes     String?
  proofUrl  String?

  @@index([userId])
  @@index([taskId])
}
