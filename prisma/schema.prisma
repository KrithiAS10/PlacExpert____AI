// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  username           String?         @unique
  phone              String?         @unique
  password           String?
  image              String?
  role               String          @default("USER") // USER or ADMIN
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Progress tracking
  currentDay         Int             @default(1)
  readinessScore     Float           @default(0.0)
  streak             Int             @default(0)

  // Student profiling answers
  academicYear       String?
  domainInterest     String?
  targetCompany      String?
  dsaCount           String?
  projects           String?
  coreCsStrength     String?
  codingPlatform     String?
  aptitude           String?
  communication      String?
  mockInterviewExp   String?
  codingConfidence   String?
  dailyStudyTime     String?
  preferredLang      String?
  placementTimeline  String?
  readinessLevel     String?
  leetcodeUsername   String?
  

  roadmaps           Roadmap[]
  surveyResult       SurveyResult?
  analytics          Analytics[]
  activities         Activity[]
}

model SurveyResult {
  id            String   @id @default(uuid())
  userId        String   @unique // Ensures one survey result per user
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedRole String
  allScores     String   // Store as a JSON string
  createdAt     DateTime @default(now())
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String   @default("My Prep Roadmap")
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String?
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
  tasks       Task[]
}

model Phase {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {

  id           String   @id @default(uuid())
  title        String
  description  String?
  day          Int      @default(1)
  dayNumber    Int?
  category     String?
  status       String   @default("PENDING")
  type         String   @default("TOPIC")
  resourceName String   @default("Explore Resource")
  resourceLink String   @default("https://roadmap.sh")
  
  roadmapId    String?
  roadmap      Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  phaseId      String?
  phase        Phase?   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model RoadmapTemplate {
  id           String @id @default(uuid())
  roleName     String
  dayNumber    Int
  title        String
  category     String @default("General")
  resourceName String @default("Explore Resource")
  resourceLink String @default("https://roadmap.sh")

  @@index([roleName])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  type        String
  category    String
  url         String
  duration    String?
  thumbnail   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}


model Analytics {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  metric    String
  value     Float
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  status    String?
  timestamp DateTime @default(now())
}
