datasource db {
  provider = "sqlite"
  url      = "file:./placexpert.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  role         String?
  currentDay   Int         @default(1)
  streak       Int         @default(0)
  roadmaps     Roadmap[]
  surveyResult SurveyResult? // New relation: A user can have one primary survey result
}

model SurveyResult {
  id            String   @id @default(uuid())
  userId        String   @unique // Ensures one survey result per user
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedRole String
  allScores     String   // Store as a JSON string
  createdAt     DateTime @default(now())
}

model Roadmap {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  status    String   @default("IN_PROGRESS")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id           String  @id @default(uuid())
  roadmapId    String
  roadmap      Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  dayNumber    Int
  title        String
  category     String
  status       String  @default("PENDING")
  resourceName String  @default("Explore Resource")
  resourceLink String  @default("https://roadmap.sh")
}

model RoadmapTemplate {
  id           String @id @default(uuid())
  roleName     String
  dayNumber    Int
  title        String
  category     String @default("General")
  resourceName String @default("Explore Resource")
  resourceLink String @default("https://roadmap.sh")

  @@index([roleName])
}