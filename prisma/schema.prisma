
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

model User {

  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  role          String    @default("USER") // USER or ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Progress tracking
  currentDay    Int       @default(1)
  readinessScore Float     @default(0.0)
  streak        Int       @default(0)

  // Student profiling answers
  academicYear       String?
  domainInterest     String?
  targetCompany      String?
  dsaCount           String?
  projects           String?
  coreCsStrength     String?
  codingPlatform     String?
  aptitude           String?
  communication      String?
  mockInterviewExp   String?
  codingConfidence   String?
  dailyStudyTime     String?
  preferredLang      String?
  placementTimeline  String?
  readinessLevel     String?
  
  roadmaps      Roadmap[]
  analytics     Analytics[]
  activities    Activity[]
}

model SurveyResult {
  id            String   @id @default(uuid())
  userId        String   @unique // Ensures one survey result per user
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedRole String
  allScores     String   // Store as a JSON string
  createdAt     DateTime @default(now())
}

model Roadmap {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  status    String   @default("IN_PROGRESS")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id           String  @id @default(uuid())
  roadmapId    String
  roadmap      Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  dayNumber    Int
  title        String
  category     String
  status       String  @default("PENDING")
  resourceName String  @default("Explore Resource")
  resourceLink String  @default("https://roadmap.sh")
}

model RoadmapTemplate {
  id           String @id @default(uuid())
  roleName     String
  dayNumber    Int
  title        String
  category     String @default("General")
  resourceName String @default("Explore Resource")
  resourceLink String @default("https://roadmap.sh")

  @@index([roleName])
}